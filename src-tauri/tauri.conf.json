{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小爱音量助手",
  "version": "1.0.2",
  "identifier": "com.onepve.soundpilot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
  "windows": [
    {
      "title": "小爱音量助手",
      "width": 1120,
      "height": 760,
      "minWidth": 900,
      "minHeight": 650,
      "center": true,
      "resizable": true,
      "visible": true
    }
  ],
  "security": {
    "csp": null
  }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
